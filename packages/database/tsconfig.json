{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {},
    "types": ["node"]
  },
  "include": ["src/**/*", "drizzle.config.local.ts"],
  "exclude": ["node_modules", "dist", "src/seed"]
}
