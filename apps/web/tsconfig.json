{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.cloudflare.json" }],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "rootDirs": [".", "./.react-router/types"],
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./app/*"],
      "collections/*": ["./.source/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/icons": ["../../packages/icons/src/index.ts"]
    }
  }
}
