IS_VERCEL = true
NODE_ENV = development

DATABASE_URL=""
SESSION_SECRET="s3cret"
JWT_SECRET=""
PRESENTATION_MODE=1 # 演示模式
PORT = 3333
OLLAMA_URL = 'http://localhost:11434'

# Cloudflare Turnstile (optional). For local dev, omit or set VITE_TURNSTILE_ENABLED=false.
# VITE_TURNSTILE_ENABLED=true
# VITE_TURNSTILE_SITE_KEY=
# Worker / wrangler: TURNSTILE_ENABLED=true + wrangler secret put TURNSTILE_SECRET_KEY

# File uploads use the Worker R2 binding `STORAGE` (see wrangler.jsonc.example → copy to wrangler.jsonc).
# Local: `wrangler r2 bucket create local-uploads` then add r2_buckets in wrangler.jsonc.
# Optional prefix for object keys:
# STORAGE_PREFIX=uploads/
# Production uploads require:
# R2_ALLOW_PRODUCTION_UPLOAD=true

# better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_BASE_PATH=/api/auth
