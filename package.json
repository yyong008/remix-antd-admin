{
  "name": "react-router-antd-admin",
  "version": "0.2.0",
  "description": "React Router Antd Admin",
  "keywords": [
    "React Router",
    "admin",
    "ai",
    "antd",
    "hono",
    "ollama",
    "tailwindcss"
  ],
  "homepage": "https://remix-antd-admin.vercel.app/",
  "license": "MIT",
  "author": {
    "name": "yong",
    "email": "yyong008@outlook.com",
    "url": "https://github.com/yyong008"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yyong008/remix-antd-admin.git"
  },
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "coverage": "vp test run --coverage",
    "dev": "react-router dev",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test",
    "cf-typegen": "wrangler types",
    "typecheck": "react-router typegen && wrangler types && tsc",
    "commit": "git-cz",
    "changeset": "changeset",
    "version": "changeset version",
    "drizzle:generate": "drizzle-kit generate",
    "auth:generate:schema": "pnpm dlx auth@latest generate --config=./db/seed/local/auth.ts --output=./db/schema/auth.ts",
    "drizzle:push": "drizzle-kit push",
    "drizzle:migrate": "drizzle-kit migrate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:setup:local": "pnpm run db:migrate:local && pnpm run db:seed:local",
    "db:generate:seed-sql": "tsx db/seed/local/generate-rbac-seed-sql.ts",
    "db:seed:local": "pnpm exec wrangler d1 execute DB --local --file=./db/seed/local/seed-local-rbac.sql",
    "db:seed": "pnpm run db:seed:local",
    "db:studio:local": "drizzle-kit studio",
    "db:generate:sqlite_file": "wrangler d1 execute DB --local --command \"SELECT 1\"",
    "cf:size": "pnpm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.2",
    "@ant-design/x": "^2.7.0",
    "@ant-design/x-sdk": "^2.7.0",
    "@cloudflare/workers-types": "^4.20260503.1",
    "@fontsource-variable/google-sans-code": "^5.2.4",
    "@fontsource-variable/rubik": "^5.2.8",
    "@inlang/paraglide-js": "^2.18.0",
    "@marsidev/react-turnstile": "^1.5.1",
    "@react-email/editor": "^1.3.2",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "@tanstack/react-query": "^5.100.9",
    "ai": "^6.0.174",
    "antd": "^6.3.7",
    "better-auth": "^1.6.9",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "is-ip": "^5.0.1",
    "isbot": "^5.1.39",
    "nanoid": "^5.1.11",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "ollama-ai-provider-v2": "^3.5.0",
    "quill": "^2.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-image-crop": "^11.0.10",
    "react-intersection-observer": "^9.16.0",
    "react-router": "^7.14.2",
    "react-type-animation": "^3.2.0",
    "remix-utils": "^9.3.1",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "ua-parser-js": "^1.0.41",
    "ui": "link:@react-email/editor/ui",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vite-plugin": "^1.35.0",
    "@libsql/client": "^0.17.3",
    "@react-router/dev": "^7.14.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.39",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.2.3",
    "@types/ua-parser-js": "^0.7.39",
    "autoprefixer": "^10.5.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.13",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.1.20",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.20",
    "wrangler": "^4.87.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
